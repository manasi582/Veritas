# Veritas Agent Configuration (macOS)
# ===================================
# Edit this file, then: sudo veritas-agent restart

# Veritas server address (where the compliance dashboard is running)
veritas_address: https://your-veritas-server:8000

# Registration key from the Veritas dashboard -> Agents -> Issue Registration Key.
# It works once and expires after 30 minutes. After the agent has registered it
# is no longer needed (the agent keeps its permanent identity in /var/lib/veritas-agent).
registration_key: ""

# TLS. By default the agent downloads the server's certificate the first time it
# connects and trusts only that certificate afterwards. To pin a certificate you
# fetched yourself (recommended for production), run:
#     sudo veritas-agent fetch-cert https://your-veritas-server:8000
# and uncomment ca_cert below.
tls:
  # ca_cert: /etc/veritas-agent/server.crt
  verify: true

# Label for this agent (appears in the dashboard)
source_label: my-mac-1

# Log sources to monitor (add as many as needed).
# The agent runs as the unprivileged account _veritas-agent. For each file it should
# read, run: sudo veritas-agent grant-read /path/to/file
sources:
  - type: file
    path: /var/log/install.log
    source_system: macos-install
  # - type: file
  #   path: /var/log/app/app.log
  #   source_system: my-app

# Mask, hash or drop personal data in a line before it leaves this machine (off unless you uncomment it).
# See docs/AGENT_REDACTION.md. It cannot find names, and it does not change the application's own log files.
# redaction:
#   mode: mask                  # monitor (default) | mask | hash | drop
#   categories:                 # optional per kind: aadhaar, pan, phone, email, card
#     card: drop
#   fail_closed: true           # if a line cannot be redacted, drop it instead of sending it raw
#   tee_file: /var/log/veritas-agent/masked.log   # optional masked copy for a log shipper
#   hash_key: ${VERITAS_HASH_KEY}                 # needed for mode: hash

# Database schema changes (a new column that looks like personal data): point at a database log that records
# CREATE/ALTER/DROP TABLE statements (PostgreSQL: log_statement = 'ddl'). Only those statements leave this machine.
# See docs/SCHEMA_WATCH.md.
#   - type: db_schema_log
#     path: /var/log/postgresql/postgresql-16-main.log
#     source_system: loan-db
