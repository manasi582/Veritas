#!/bin/bash
set -e

# Create system user for the agent
if ! id veritas-agent &>/dev/null; then
    useradd --system --no-create-home --shell /usr/sbin/nologin \
        --home-dir /opt/veritas-agent veritas-agent
fi

# The configuration belongs to the administrator: created once from the example, never replaced by an upgrade.
# (A copy kept by preinst is put back if the old package's removal took the file away.)
mkdir -p /etc/veritas-agent
if [ ! -e /etc/veritas-agent/config.yaml ]; then
    if [ -f /var/lib/veritas-agent/.config.yaml.keep ]; then
        cp -p /var/lib/veritas-agent/.config.yaml.keep /etc/veritas-agent/config.yaml
    elif [ -f /usr/share/veritas-agent/config.yaml.example ]; then
        cp /usr/share/veritas-agent/config.yaml.example /etc/veritas-agent/config.yaml
    fi
fi
rm -f /var/lib/veritas-agent/.config.yaml.keep

# Permissions
chown -R veritas-agent:veritas-agent /opt/veritas-agent /etc/veritas-agent
chmod 640 /etc/veritas-agent/config.yaml

# Enable systemd service. A first install does not start it (the administrator must configure it first).
systemctl daemon-reload
systemctl enable veritas-agent

# An upgrade (prerm stopped the agent) or a refused upgrade (abort-upgrade) must bring an agent that is already
# set up back; "set up" means it has registered and saved its identity.
if { [ "$1" = "configure" ] && [ -n "$2" ]; } || [ "$1" = "abort-upgrade" ]; then
    if [ -s /var/lib/veritas-agent/.veritas_state.json ]; then
        systemctl start veritas-agent || true
    fi
fi

echo ""
echo "Veritas Agent installed successfully!"
echo ""
echo "Next steps:"
echo "  1. In the Veritas dashboard: Agents -> Issue Registration Key (valid 30 minutes)"
echo "  2. Edit /etc/veritas-agent/config.yaml"
echo "     Set: veritas_address, registration_key, source_label and the sources to read"
echo "  3. sudo systemctl start veritas-agent"
echo "  4. Verify: sudo veritas-agent logs   (expect 'Registered as VERITAS-AGENT-...')"
echo ""
echo "The agent runs as the 'veritas-agent' user with read access to files that group"
echo "'adm' can read (most of /var/log). For other log files, grant that user read access."
echo "To read Docker container logs, add the user to the 'docker' group."
