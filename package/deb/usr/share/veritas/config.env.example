# Veritas Configuration
# Edit this file to configure Veritas, then: sudo systemctl restart veritas

# TLS (recommended for production)
VERITAS_TLS=auto

# AI Investigation (optional — leave blank to disable)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# VERITAS_AI_MODE=external

# Port (default: 8000)
# VERITAS_PORT=8000
