#!/bin/bash
# Veritas CLI — manage the Veritas compliance service
RUNTIME=/opt/veritas/veritas-runtime
DATA_DIR=/var/lib/veritas
VERSION=$(dpkg-query -W -f='${Version}' veritas 2>/dev/null || echo unknown)
URL="https://$(hostname -f 2>/dev/null || hostname):8000"

case "$1" in
  start)    systemctl start veritas && echo "Veritas started. Open $URL/setup (self-signed certificate; allow the browser warning). First time: it asks for a setup code, shown by: sudo veritas setup-code" ;;
  stop)     systemctl stop veritas ;;
  restart)  systemctl restart veritas ;;
  status)   systemctl status veritas ;;
  logs)     journalctl -u veritas -f ;;
  check)    runuser -u veritas -- env VERITAS_DATA_DIR="$DATA_DIR" "$RUNTIME" --check ;;

  fingerprint)
    # The runtime is the single source of truth for the fingerprint, so this
    # always matches what the service checks the license against.
    if ! FP=$("$RUNTIME" --fingerprint 2>&1); then
      echo "ERROR: could not determine this machine's fingerprint:" >&2
      echo "$FP" >&2
      exit 1
    fi
    echo "Veritas Machine Fingerprint"
    echo "==========================================================================="
    echo "Send this fingerprint to your Veritas contact to receive your license"
    echo "file (veritas.vlic):"
    echo
    echo "$FP"
    echo
    ;;

  setup-code)
    # The one-time code the setup page asks for, so that only someone with access to this
    # server can create the first administrator. Created when the service starts; removed
    # once the first administrator exists.
    if [ "$(id -u)" -ne 0 ]; then echo "This command needs administrator rights. Run: sudo veritas setup-code" >&2; exit 1; fi
    CODE_FILE="$DATA_DIR/secrets/setup_code"
    if [ -s "$CODE_FILE" ]; then
      echo "Setup code (enter it on the setup page at $URL/setup):"
      echo
      cat "$CODE_FILE"
      echo
    else
      echo "There is no setup code. Either setup is already complete (an administrator exists)," >&2
      echo "or the service has not started yet. Start it with: sudo veritas start" >&2
      exit 1
    fi
    ;;

  license)
    LICENSE_FILE=/var/lib/veritas/veritas.vlic
    if [ -z "$2" ]; then
      echo "Usage: veritas license <path-to-veritas.vlic>"
      echo "       Installs your license file and restarts Veritas."
      exit 1
    fi
    cp "$2" "$LICENSE_FILE"
    # Strip quarantine/ACL attrs (macOS) then fix ownership
    xattr -c "$LICENSE_FILE" 2>/dev/null || true
    chown veritas:veritas "$LICENSE_FILE" 2>/dev/null || \
      chown veritas:staff  "$LICENSE_FILE" 2>/dev/null || true
    chmod 640 "$LICENSE_FILE"
    systemctl restart veritas
    echo "License installed. Veritas is restarting..."
    # The runtime checks the license first and exits (code 78) if it is invalid.
    # A valid start takes up to a minute while the language model loads.
    STATE=starting
    for _ in $(seq 1 90); do
      sleep 1
      if systemctl is-failed --quiet veritas; then STATE=failed; break; fi
      if curl -sk "https://localhost:8000/health" 2>/dev/null | grep -q '"status":"ok"'; then STATE=up; break; fi
    done
    case "$STATE" in
      up)
        echo "  Status: running"
        echo "  Open:   $URL/setup (self-signed certificate; allow the browser warning)"
        ;;
      failed)
        echo "  Status: NOT running. Last log lines:" >&2
        journalctl -u veritas -n 15 --no-pager >&2
        exit 1
        ;;
      *)
        echo "  Status: still starting. Check with: veritas status / veritas logs"
        ;;
    esac
    ;;

  reset-password)
    # Lost administrator password: set a temporary one (the user must choose their own at sign-in).
    if [ -z "$2" ]; then
      echo "Usage: veritas reset-password <username>"
      exit 1
    fi
    runuser -u veritas -- env VERITAS_DATA_DIR="$DATA_DIR" "$RUNTIME" --reset-password "$2"
    ;;

  install-cert)
    # Replace the self-signed certificate with one issued by your company (or a public CA).
    if [ -z "$2" ] || [ -z "$3" ]; then
      echo "Usage: veritas install-cert <certificate.pem> <private-key.pem>"
      echo "       The certificate file may contain the intermediate certificates after the"
      echo "       server certificate. The key must not be protected by a passphrase."
      exit 1
    fi
    if ! env VERITAS_DATA_DIR="$DATA_DIR" "$RUNTIME" --install-cert "$2" "$3"; then
      exit 1
    fi
    chown -R veritas:veritas "$DATA_DIR/certs" 2>/dev/null || true
    chmod 600 "$DATA_DIR/certs/server.key" 2>/dev/null || true
    systemctl restart veritas && echo "Veritas is restarting with the new certificate."
    ;;

  version)  echo "Veritas $VERSION" ;;
  *)
    echo "Veritas DPDPA Compliance Platform v$VERSION"
    echo ""
    echo "Usage: veritas <command>"
    echo ""
    echo "Commands:"
    echo "  start         Start the Veritas service"
    echo "  stop          Stop the Veritas service"
    echo "  restart       Restart the Veritas service"
    echo "  status        Show service status"
    echo "  logs          Stream service logs (Ctrl+C to stop)"
    echo "  check         Run production acceptance checks"
    echo "  fingerprint   Print machine fingerprint (send to Veritas for license)"
    echo "  setup-code    Print the one-time code the setup page asks for"
    echo "  license <f>   Install license file and restart"
    echo "  reset-password <user>   Set a temporary password (lost administrator password)"
    echo "  install-cert <cert> <key>   Install a company TLS certificate and restart"
    echo "  version       Print version"
    echo ""
    echo "Getting started:"
    echo "  1. sudo veritas fingerprint   → send output to your Veritas contact"
    echo "  2. sudo veritas license /path/to/veritas.vlic"
    echo "  3. sudo veritas start"
    echo "  4. Open $URL/setup and enter the code from: sudo veritas setup-code"
    ;;
esac
