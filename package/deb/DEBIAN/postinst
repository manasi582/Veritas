#!/bin/bash
# Veritas Linux post-install script
# dpkg treats any non-zero exit as failure — we handle errors explicitly.

set -e

# Create system user veritas (no login) if not exists
if ! id veritas &>/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin \
        --home-dir /opt/veritas veritas
fi

# Create runtime directories (idempotent)
mkdir -p /var/lib/veritas /var/lib/veritas/tmp /var/log/veritas /etc/veritas

# The settings file belongs to the administrator: created once from the example, never replaced by an
# upgrade. (A copy kept by preinst is put back if the old package's removal took the file away.)
if [ ! -e /etc/veritas/config.env ]; then
    if [ -f /var/lib/veritas/.config.env.keep ]; then
        cp -p /var/lib/veritas/.config.env.keep /etc/veritas/config.env
    elif [ -f /usr/share/veritas/config.env.example ]; then
        cp /usr/share/veritas/config.env.example /etc/veritas/config.env
    fi
fi
rm -f /var/lib/veritas/.config.env.keep

# Fix ownership — || true so upgrade doesn't fail on locked files
# The program belongs to root: the service account must not be able to replace its own binary.
chown -R root:root /opt/veritas 2>/dev/null || true
chown -R veritas:veritas /var/lib/veritas /var/log/veritas /etc/veritas 2>/dev/null || true
chmod 700 /var/lib/veritas
chmod 755 /var/lib/veritas/tmp

# Fix license file ownership if it was installed before postinst (upgrade)
if [ -f /var/lib/veritas/veritas.vlic ]; then
    chown veritas:veritas /var/lib/veritas/veritas.vlic 2>/dev/null || true
    chmod 640 /var/lib/veritas/veritas.vlic
fi

# Reload systemd and enable (but don't start — needs license first)
systemctl daemon-reload
systemctl enable veritas

# An upgrade stopped the service (prerm) and must bring it back, also when the new package was
# refused (abort-upgrade). A first install waits for a license instead.
if { [ "$1" = "configure" ] && [ -n "$2" ]; } || [ "$1" = "abort-upgrade" ]; then
    if [ -f /var/lib/veritas/veritas.vlic ]; then
        systemctl start veritas || true
    fi
fi

echo ""
echo "Veritas DPDPA Compliance Platform installed successfully!"
echo ""
echo "  1. Send this machine's fingerprint to Veritas to get your license:"
FP=$(/opt/veritas/veritas-runtime --fingerprint 2>/dev/null) || FP=""
if [ -n "$FP" ]; then
    echo "       $FP"
else
    echo "       (run: sudo veritas fingerprint)"
fi
echo "  2. sudo veritas license /path/to/veritas.vlic"
echo "  3. sudo veritas start"
echo "  4. Open https://<this-host>:8000/setup (self-signed certificate) and enter the code from: sudo veritas setup-code"
echo ""
echo "CLI: veritas {start|stop|restart|status|logs|fingerprint|license|setup-code|check|version}"
echo ""
