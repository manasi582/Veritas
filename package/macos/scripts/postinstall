#!/bin/bash
# Veritas macOS post-install script
# Runs as root after package payload is installed.
# IMPORTANT: never use set -e here — installer treats any non-zero exit
# as a fatal error. We handle each step explicitly instead.

PLIST_SRC=/opt/veritas/com.veritas.daemon.plist
PLIST_DST=/Library/LaunchDaemons/com.veritas.daemon.plist
DATA_DIR=/var/lib/veritas
LOG_DIR=/var/log/veritas
USER_NAME=_veritas

echo "[Veritas] Running post-install setup..."

# ── 1. Ensure any existing daemon is stopped ────────────────────────────────
echo "[Veritas] Stopping existing service (if running)..."
launchctl bootout system "$PLIST_DST" 2>/dev/null || true
launchctl unload -w "$PLIST_DST" 2>/dev/null || true
sleep 1

# ── 2. Create _veritas system user ─────────────────────────────────────────
if ! id "$USER_NAME" &>/dev/null 2>&1; then
    echo "[Veritas] Creating system user $USER_NAME..."
    # Find unused UID in 300-499 range
    USED=$(dscl . -list /Users UniqueID 2>/dev/null | awk '{print $2}')
    NEW_UID=398
    while echo "$USED" | grep -q "^${NEW_UID}$" 2>/dev/null; do
        NEW_UID=$((NEW_UID + 1))
    done

    dscl . -create /Users/$USER_NAME 2>/dev/null || true
    dscl . -create /Users/$USER_NAME UserShell /usr/bin/false 2>/dev/null || true
    dscl . -create /Users/$USER_NAME RealName "Veritas Service" 2>/dev/null || true
    dscl . -create /Users/$USER_NAME UniqueID "$NEW_UID" 2>/dev/null || true
    dscl . -create /Users/$USER_NAME PrimaryGroupID 20 2>/dev/null || true
    dscl . -create /Users/$USER_NAME NFSHomeDirectory /opt/veritas 2>/dev/null || true
    echo "[Veritas] User $USER_NAME created (UID $NEW_UID)."
else
    echo "[Veritas] User $USER_NAME already exists — skipping creation."
fi

# ── 3. Create runtime directories ───────────────────────────────────────────
echo "[Veritas] Setting up data directories..."
mkdir -p "$DATA_DIR" "$DATA_DIR/tmp" "$LOG_DIR" 2>/dev/null || true
chown -R "$USER_NAME":staff "$DATA_DIR" "$LOG_DIR" 2>/dev/null || true
# the program itself belongs to root: the service must not be able to replace its own binary
chown -R root:wheel /opt/veritas 2>/dev/null || true
chmod 700 "$DATA_DIR" 2>/dev/null || true
chmod 755 "$DATA_DIR/tmp" 2>/dev/null || true

chmod 750 "$LOG_DIR" 2>/dev/null || true
chmod 600 "$LOG_DIR"/* 2>/dev/null || true   # logs from earlier versions were readable by everyone

# ── 3b. Settings file (kept across upgrades: created only when it does not exist) ──
mkdir -p /etc/veritas 2>/dev/null || true
if [ ! -e /etc/veritas/config.env ] && [ -f /opt/veritas/config.env.example ]; then
    cp /opt/veritas/config.env.example /etc/veritas/config.env
fi
# it can hold a mail password or a token: root and the service account may read it, other users may
# not. The service account has no group of its own (it shares "staff" with every local user), so it is
# let in by an access-control entry, not by the group.
chown root:wheel /etc/veritas /etc/veritas/config.env 2>/dev/null || true
chmod 750 /etc/veritas 2>/dev/null || true
chmod 600 /etc/veritas/config.env 2>/dev/null || true
chmod -N /etc/veritas /etc/veritas/config.env 2>/dev/null || true       # start clean on an upgrade
chmod +a "user:$USER_NAME allow list,search,readattr,readextattr,readsecurity" /etc/veritas 2>/dev/null || true
chmod +a "user:$USER_NAME allow read,readattr,readextattr,readsecurity" /etc/veritas/config.env 2>/dev/null || true

# ── 4. Install LaunchDaemon plist ───────────────────────────────────────────
echo "[Veritas] Installing LaunchDaemon..."
if [ -f "$PLIST_SRC" ]; then
    cp -f "$PLIST_SRC" "$PLIST_DST" 2>/dev/null || true
    chown root:wheel "$PLIST_DST" 2>/dev/null || true
    chmod 644 "$PLIST_DST" 2>/dev/null || true
    echo "[Veritas] Plist installed at $PLIST_DST"
else
    echo "[Veritas] WARNING: plist not found at $PLIST_SRC — skipping."
fi

# ── 5. Load the daemon ───────────────────────────────────────────────────────
# Note: daemon will exit immediately if no license is present — that's OK.
# The user installs the license separately with: sudo veritas license <file>
echo "[Veritas] Loading daemon (will wait for license)..."
if launchctl bootstrap system "$PLIST_DST" 2>/dev/null; then
    echo "[Veritas] Daemon loaded via bootstrap."
elif launchctl load -w "$PLIST_DST" 2>/dev/null; then
    echo "[Veritas] Daemon loaded via launchctl load."
else
    echo "[Veritas] Note: daemon not auto-started. Start after installing license:"
    echo "          sudo veritas license /path/to/veritas.vlic"
    echo "          sudo veritas start"
fi

echo ""
echo "================================================"
echo "  Veritas DPDPA Platform installed successfully!"
echo "================================================"
echo ""
echo "Next steps:"
echo "  1. veritas fingerprint"
echo "     Send output to your Veritas contact for a license."
echo ""
echo "  2. sudo veritas license /path/to/veritas.vlic"
echo "     Install your license file; Veritas starts by itself."
echo ""
echo "  3. sudo veritas setup-code"
echo "     Then open: https://localhost:8000/setup and enter the code."
echo ""

# Always exit 0 — let the user complete setup manually
exit 0
