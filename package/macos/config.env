# Veritas settings. One NAME=value per line; lines starting with # are comments.
# After editing:  sudo veritas restart
# This file is kept when you upgrade or uninstall Veritas (only `sudo veritas uninstall --purge-data` removes it).
# A setting in the service definition (/Library/LaunchDaemons/com.veritas.daemon.plist) wins over this file.

# TLS: auto (own certificate) or off
# VERITAS_TLS=auto

# Port (default 8000)
# VERITAS_PORT=8000

# Capacity: detection worker processes (each holds the language model, about 1 GB of memory).
# auto = one per spare core, as memory allows, at most 4; 0 = one background thread.
# VERITAS_DETECTION_WORKERS=auto
# Events that may wait for a free worker before new ones are told "busy, retry" (default 50 per worker)
# VERITAS_DETECTION_QUEUE=100

# Backups: how often (hours) and how many to keep; where to put them (another disk is safer)
# VERITAS_BACKUP_INTERVAL_HOURS=24
# VERITAS_BACKUP_KEEP=7
# VERITAS_BACKUP_DIR=/Volumes/Backup/veritas

# Alerts: tell people when something needs them (see docs/OPERATIONS.md)
# VERITAS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# VERITAS_ALERT_EMAIL_TO=compliance@example.com
# VERITAS_SMTP_HOST=mail.example.com
# VERITAS_SMTP_PORT=587
# VERITAS_SMTP_USER=veritas
# VERITAS_SMTP_PASSWORD=
# VERITAS_ALERT_MIN_SEVERITY=HIGH
# VERITAS_PUBLIC_URL=https://veritas.example.com:8000

# Evidence anchoring: a folder (ideally a remote share that the Veritas account may add to but not change)
# that receives signed checkpoints of the evidence chain. See docs/ANCHORING.md.
# VERITAS_ANCHOR_DIR=/Volumes/AuditWitness/veritas

# Incidents: findings of the same kind are grouped (on by default). A resolved incident that sees the same
# finding again after this many seconds is reopened as "recurred". See docs/INCIDENTS.md.
# VERITAS_INCIDENTS=on
# VERITAS_INCIDENT_GRACE_SECONDS=3600

# Observed processing map: counts of which systems produced which kinds of personal data (on by default).
# VERITAS_FLOWS=on

# Retention review (docs/RETENTION_REVIEW.md): warn this many days before a declared period runs out, and treat data as
# "still being seen" if it was seen within this many days.
# VERITAS_RETENTION_WARN_DAYS=14
# VERITAS_RETENTION_OBSERVED_DAYS=7

# Metrics for your monitoring system (at least 16 characters; GET /metrics with this bearer token)
# VERITAS_METRICS_TOKEN=

# AI explanations (off unless set)
# VERITAS_AI_MODE=external
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
